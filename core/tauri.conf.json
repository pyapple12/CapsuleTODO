{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CapsuleTODO",
  "identifier": "com.pyapple12.capsule-todo",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'"
    },
    "windows": [
      {
        "title": "CapsuleTODO",
        "width": 300,
        "height": 400,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico"]
  }
}
