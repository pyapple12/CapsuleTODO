{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CapsuleTODO",
  "identifier": "com.pyapple12.capsule-todo",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "CapsuleTODO",
        "width": 300,
        "height": 400,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico"]
  }
}
